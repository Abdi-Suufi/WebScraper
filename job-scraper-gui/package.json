{
  "name": "job-scraper-gui",
  "version": "2.0.0",
  "private": true,
  "description": "A secure UK job search and application tracking desktop app",
  "license": "MIT",
  "author": "Abdi Rahman Suufi",
  "packageManager": "pnpm@12.14.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm icon:win && electron-vite build",
    "build:win": "pnpm build && electron-builder --win nsis",
    "release": "pnpm icon:win && electron-vite build && electron-builder --win nsis --publish always",
    "typecheck": "pnpm typecheck:main && pnpm typecheck:renderer",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "icon:win": "node scripts/create-icon.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "uk.co.abdis.jobsearch",
    "productName": "Job Search",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Abdi-Suufi",
        "repo": "WebScraper",
        "releaseType": "release"
      }
    ]
  }
}
